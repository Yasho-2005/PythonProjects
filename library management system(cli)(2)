# Step 1: Create Book Class

class Book:
    def __init__(self, book_id, title, author, copies):
        self.book_id = book_id
        self.title = title
        self.author = author
        self.total_copies = copies
        self.available_copies = copies

    def display(self):
        print(f"Book ID          : {self.book_id}")
        print(f"Title            : {self.title}")
        print(f"Author           : {self.author}")
        print(f"Total Copies     : {self.total_copies}")
        print(f"Available Copies : {self.available_copies}")


# Step 2: Create Empty List

library = []


# Step 3: Add Book

def add_book():

    book_id = int(input("Enter Book ID : "))
    title = input("Enter Book Title : ")
    author = input("Enter Author Name : ")
    copies = int(input("Enter Number of Copies : "))

    book = Book(book_id, title, author, copies)

    library.append(book)

    print("Book Added Successfully!")


# Step 4: Display Books

def display_books():

    if len(library) == 0:
        print("No Books Available.")
        return

    print("\nLibrary Books\n")

    for book in library:
        book.display()
        print("-" * 35)


# Step 5: Search Book by Title

def search_title():

    title = input("Enter Book Title : ").lower()

    for book in library:

        if book.title.lower() == title:

            print("\nBook Found")
            book.display()
            return

    print("Book Not Found.")


# Step 6: Search Book by Author

def search_author():

    author = input("Enter Author Name : ").lower()

    found = False

    for book in library:

        if book.author.lower() == author:
            book.display()
            print("-" * 35)
            found = True

    if not found:
        print("No Books Found.")


# Step 7: Issue Book

def issue_book():

    book_id = int(input("Enter Book ID : "))

    for book in library:

        if book.book_id == book_id:

            if book.available_copies > 0:

                book.available_copies -= 1

                print("Book Issued Successfully!")

            else:

                print("Book Not Available.")

            return

    print("Book Not Found.")


# Step 8: Return Book

def return_book():

    book_id = int(input("Enter Book ID : "))

    for book in library:

        if book.book_id == book_id:

            if book.available_copies < book.total_copies:

                book.available_copies += 1

                print("Book Returned Successfully!")

            else:

                print("All Copies Are Already Available.")

            return

    print("Book Not Found.")


# Step 9: Fine Calculation

def calculate_fine():

    days = int(input("Enter Number of Days Book Was Kept : "))

    if days <= 7:

        fine = 0

    else:

        fine = (days - 7) * 5

    print("Fine Amount : ₹", fine)


# Step 10: Main Menu

while True:

    print("\n===== Library Management System =====")
    print("1. Add Book")
    print("2. Display Books")
    print("3. Search Book by Title")
    print("4. Search Book by Author")
    print("5. Issue Book")
    print("6. Return Book")
    print("7. Calculate Fine")
    print("8. Exit")

    choice = input("Enter Choice : ")

    if choice == "1":
        add_book()

    elif choice == "2":
        display_books()

    elif choice == "3":
        search_title()

    elif choice == "4":
        search_author()

    elif choice == "5":
        issue_book()

    elif choice == "6":
        return_book()

    elif choice == "7":
        calculate_fine()

    elif choice == "8":
        print("Thank You!")
        break

    else:
        print("Invalid Choice!")
