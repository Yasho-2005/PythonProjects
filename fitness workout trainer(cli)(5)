# Step 1: Create Workout Class

class Workout:

    def __init__(self, day, exercise, duration, calories):
        self.day = day
        self.exercise = exercise
        self.duration = duration
        self.calories = calories

    def display(self):
        print(f"Day             : {self.day}")
        print(f"Exercise        : {self.exercise}")
        print(f"Duration        : {self.duration} minutes")
        print(f"Calories Burned : {self.calories}")


# Step 2: Create Empty List

workouts = []


# Step 3: Log Workout

def add_workout():

    day = input("Enter Day : ")
    exercise = input("Enter Exercise : ")
    duration = int(input("Enter Duration (minutes) : "))
    calories = float(input("Enter Calories Burned : "))

    workout = Workout(day, exercise, duration, calories)

    workouts.append(workout)

    print("Workout Logged Successfully!")


# Step 4: Display Workouts

def display_workouts():

    if len(workouts) == 0:
        print("No Workout Records Found.")
        return

    print("\nWorkout Records\n")

    for workout in workouts:
        workout.display()
        print("-" * 35)


# Step 5: Search Workout by Day

def search_workout():

    day = input("Enter Day : ").lower()

    found = False

    for workout in workouts:

        if workout.day.lower() == day:

            workout.display()
            print("-" * 35)
            found = True

    if not found:
        print("No Workout Found.")


# Step 6: Delete Workout

def delete_workout():

    day = input("Enter Day : ").lower()

    for workout in workouts:

        if workout.day.lower() == day:

            workouts.remove(workout)

            print("Workout Deleted Successfully!")
            return

    print("Workout Not Found.")


# Step 7: Calculate Total Calories Burned

def total_calories():

    if len(workouts) == 0:
        print("No Workout Records.")
        return

    total = 0

    for workout in workouts:
        total += workout.calories

    print("Total Calories Burned :", total)


# Step 8: Weekly Progress

def weekly_progress():

    if len(workouts) == 0:
        print("No Workout Records.")
        return

    total_duration = 0
    total_calories = 0

    for workout in workouts:
        total_duration += workout.duration
        total_calories += workout.calories

    print("\nWeekly Progress")
    print("----------------------")
    print("Total Workouts :", len(workouts))
    print("Total Duration :", total_duration, "minutes")
    print("Calories Burned :", total_calories)


# Step 9: BMI Calculator

def bmi_calculator():

    weight = float(input("Enter Weight (kg) : "))
    height = float(input("Enter Height (meters) : "))

    bmi = weight / (height * height)

    print("BMI :", round(bmi, 2))

    if bmi < 18.5:
        print("Category : Underweight")

    elif bmi < 25:
        print("Category : Normal Weight")

    elif bmi < 30:
        print("Category : Overweight")

    else:
        print("Category : Obese")


# Step 10: Main Menu

while True:

    print("\n===== Fitness Workout Tracker =====")
    print("1. Log Workout")
    print("2. Display Workouts")
    print("3. Search Workout")
    print("4. Delete Workout")
    print("5. Total Calories Burned")
    print("6. Weekly Progress")
    print("7. BMI Calculator")
    print("8. Exit")

    choice = input("Enter Choice : ")

    if choice == "1":
        add_workout()

    elif choice == "2":
        display_workouts()

    elif choice == "3":
        search_workout()

    elif choice == "4":
        delete_workout()

    elif choice == "5":
        total_calories()

    elif choice == "6":
        weekly_progress()

    elif choice == "7":
        bmi_calculator()

    elif choice == "8":
        print("Thank You!")
        break

    else:
        print("Invalid Choice!")
